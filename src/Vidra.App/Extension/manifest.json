{
  "manifest_version": 3,
  "name": "Vidra",
  "version": "0.3.0",
  "description": "YouTube bağlantılarını Vidra'ya gönderir ve YouTube oturumunu Vidra ile eşitler.",
  "key": "",
  "permissions": ["contextMenus", "cookies", "nativeMessaging"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Bu sayfayı Vidra'da aç", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
