<Window x:Class="Vidra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vidra.App.ViewModels"
        xmlns:v="clr-namespace:Vidra.App.Views"
        xmlns:c="clr-namespace:Vidra.App.Controls"
        Title="Vidra" Width="1360" Height="880" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/vidra.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragEnter" PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave" PreviewDrop="Window_PreviewDrop">
  <!-- Kendi başlık çubuğumuz: içerik pencerenin en üstüne kadar uzanır, üst 36px sürüklenebilir -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Style>
    <Style TargetType="Window">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Style.Triggers>
        <!-- Ekranı kaplayınca pencere kenarları ekran dışına taşar: o kadar içeri al -->
        <Trigger Property="WindowState" Value="Maximized">
          <Setter Property="BorderThickness" Value="7" />
          <Setter Property="BorderBrush" Value="{DynamicResource Bg}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Style>
  <!-- Genel kısayollar (Ctrl+L, Ctrl+F ve metin kutusu dışında Ctrl+V kod tarafında: odak gerektirir) -->
  <Window.InputBindings>
    <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Download" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Search" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Playlist" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Basket" />
    <KeyBinding Key="D5" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Queue" />
    <KeyBinding Key="D6" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Library" />
    <KeyBinding Key="D7" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Stats" />
    <KeyBinding Key="D8" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Account" />
    <KeyBinding Key="D9" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Settings" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding GoToCommand}" CommandParameter="Settings" />
  </Window.InputBindings>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DownloadViewModel}"><v:DownloadView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SearchViewModel}"><v:SearchView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaylistViewModel}"><v:PlaylistView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:QueueViewModel}"><v:QueueView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BasketViewModel}"><v:BasketView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><v:LibraryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StatsViewModel}"><v:StatsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountViewModel}"><v:AccountView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogViewModel}"><v:LogView /></DataTemplate>

    <!-- Komut paleti satırı: seçili satır vurgulu; odak metin kutusunda kalır (ok tuşları kod tarafında) -->
    <Style x:Key="PaletteItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,7" Margin="6,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============ Kenar menü ============ -->
    <Border Grid.RowSpan="2" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="10,12,10,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,16">
          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Accent}">
            <c:Icon Data="{StaticResource I.Download}" Size="14" Thickness="2.4" Foreground="{DynamicResource AccentInk}" />
          </Border>
          <TextBlock Text="Vidra" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Komut paleti: sayfa, eylem ve geçmişte arama -->
        <Button DockPanel.Dock="Top" Margin="0,0,0,12" Padding="10,0,6,0" MinHeight="32" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                Foreground="{DynamicResource Muted}" Command="{Binding OpenPaletteCommand}"
                ToolTip="Komut paleti: sayfalar, eylemler, geçmiş (Ctrl+K)" AutomationProperties.Name="Komut paleti">
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Kbd}" Margin="0"><TextBlock Text="Ctrl K" FontSize="11" /></Border>
            <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Search}" Size="15" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Komut ara…" FontSize="13" VerticalAlignment="Center" />
          </DockPanel>
        </Button>

        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Download}" ToolTip="Ctrl+1">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Download}" Margin="0,0,10,0" /><TextBlock Text="İndir" /></StackPanel>
        </RadioButton>
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Search}" ToolTip="Ctrl+2">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Search}" Margin="0,0,10,0" /><TextBlock Text="Ara" /></StackPanel>
        </RadioButton>
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Playlist}" ToolTip="Ctrl+3">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Playlist}" Margin="0,0,10,0" /><TextBlock Text="Playlist &amp; kanal" /></StackPanel>
        </RadioButton>
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Basket}" ToolTip="Ctrl+4">
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource Raised}" CornerRadius="10" Padding="7,1" Margin="8,0,0,0"
                    Visibility="{Binding Basket.Items.Count, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding Basket.Items.Count}" FontSize="12" FontWeight="Bold" />
            </Border>
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Basket}" Margin="0,0,10,0" /><TextBlock Text="Sepet" /></StackPanel>
          </DockPanel>
        </RadioButton>
        <!-- Günlük kuyruğun alt sayfası: oradayken de seçili görünür; Command, seçiliyken tıklanınca kuyruğa döndürür -->
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding GoToCommand}" CommandParameter="Queue"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Queue|Log}" ToolTip="Ctrl+5">
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="10" Padding="7,1" Margin="8,0,0,0"
                    Visibility="{Binding ActiveCount, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding ActiveCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" />
            </Border>
            <DockPanel><c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Clock}" Margin="0,0,10,0" /><TextBlock Text="Kuyruk &amp; geçmiş" TextTrimming="CharacterEllipsis" /></DockPanel>
          </DockPanel>
        </RadioButton>
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Library}" ToolTip="Ctrl+6">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Library}" Margin="0,0,10,0" /><TextBlock Text="Kütüphane" /></StackPanel>
        </RadioButton>

        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" Margin="10,10,10,10" />
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Stats}" ToolTip="Ctrl+7">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Chart}" Margin="0,0,10,0" /><TextBlock Text="İstatistik" /></StackPanel>
        </RadioButton>
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Account}" ToolTip="Ctrl+8">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.User}" Margin="0,0,10,0" /><TextBlock Text="Hesabım" /></StackPanel>
        </RadioButton>
        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav"
                     IsChecked="{Binding Page, Converter={StaticResource EnumBool}, ConverterParameter=Settings}" ToolTip="Ctrl+9">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Settings}" Margin="0,0,10,0" /><TextBlock Text="Ayarlar" /></StackPanel>
        </RadioButton>

        <!-- Alt durum: kutusuz, tek satırlar -->
        <StackPanel DockPanel.Dock="Bottom" Margin="10,0,2,0" TextElement.FontSize="12.5" TextElement.Foreground="{DynamicResource Muted}">
          <!-- Gizli mod göstergesi: tıklayınca kapanır -->
          <Border Background="{DynamicResource Invert}" CornerRadius="8" HorizontalAlignment="Left" Margin="-2,0,8,10"
                  Visibility="{Binding Incognito, Converter={StaticResource Vis}}">
            <Button Style="{StaticResource ToastBtn}" Foreground="{DynamicResource InvertInk}" FontSize="12.5" MinHeight="26" Padding="8,0"
                    Command="{Binding ToggleIncognitoCommand}" ToolTip="Gizli mod açık: yeni indirmeler geçmişe ve arşive yazılmaz. Kapatmak için tıkla.">
              <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Lock}" Size="13" Margin="0,0,6,0" /><TextBlock Text="Gizli mod" /></StackPanel>
            </Button>
          </Border>
          <DockPanel Margin="0,0,8,6" Visibility="{Binding SpeedLabel, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding SpeedLabel}" DockPanel.Dock="Right" Style="{StaticResource Mono}" Foreground="{DynamicResource Text}" />
            <TextBlock Text="İndiriliyor" />
          </DockPanel>
          <TextBlock Text="{Binding DiskLabel}" Margin="0,0,0,4" Visibility="{Binding DiskLabel, Converter={StaticResource Vis}}" />
          <Button Style="{StaticResource BtnLink}" Padding="0" MinHeight="22" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Foreground="{DynamicResource Muted}"
                  Command="{Binding AccountStatusCommand}" ToolTip="Hesabım">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Line2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CookieActive}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding CookieLabel}" FontSize="12.5" FontWeight="Normal" />
            </StackPanel>
          </Button>
          <DockPanel Margin="-8,6,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource BtnGhostIcon}" Width="30" Height="30" MinHeight="30"
                    Command="{Binding ToggleThemeCommand}" ToolTip="Açık / koyu tema" AutomationProperties.Name="Temayı değiştir">
              <c:Icon Data="{StaticResource I.Sun}" Size="16" />
            </Button>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="{Binding Version}" FontSize="11.5" VerticalAlignment="Center" Visibility="{Binding Update, Converter={StaticResource Vis}, ConverterParameter=!}" />
              <Button Style="{StaticResource BtnLink}" Padding="0" MinHeight="22" FontSize="12" Command="{Binding OpenUpdateCommand}"
                      Visibility="{Binding Update, Converter={StaticResource Vis}}" ToolTip="Yeni sürümün sayfasını aç">
                <TextBlock><Run Text="{Binding Update.Tag, Mode=OneWay}" /><Run Text=" çıktı" /></TextBlock>
              </Button>
            </Grid>
          </DockPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ Başlık çubuğu düğmeleri ============ -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button Style="{StaticResource CaptionBtn}" Click="Minimize_Click" ToolTip="Simge durumuna küçült" AutomationProperties.Name="Küçült">
        <c:Icon Data="{StaticResource I.WinMin}" Size="14" Thickness="1.2" />
      </Button>
      <Button Style="{StaticResource CaptionBtn}" Click="Maximize_Click" ToolTip="Ekranı kapla / geri yükle" AutomationProperties.Name="Ekranı kapla">
        <c:Icon Data="{StaticResource I.WinMax}" Size="12" Thickness="1.4" />
      </Button>
      <Button Style="{StaticResource CaptionClose}" Click="Close_Click" ToolTip="Kapat" AutomationProperties.Name="Kapat">
        <c:Icon Data="{StaticResource I.X}" Size="14" Thickness="1.2" />
      </Button>
    </StackPanel>

    <!-- ============ İçerik ============ -->
    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Pano şeridi -->
      <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Margin="32,0,32,6" Padding="12,4,4,4"
              Visibility="{Binding ClipboardLink, Converter={StaticResource Vis}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource BtnSm}" Content="Analiz et" Command="{Binding AnalyzeClipboardCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource BtnSm}" Content="Kapat" Command="{Binding DismissClipboardCommand}" />
          </StackPanel>
          <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Link}" Foreground="{DynamicResource AccentStrong}" Margin="0,0,10,0" />
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="Panoda YouTube bağlantısı bulundu:" FontWeight="SemiBold" />
            <Run Text="{Binding ClipboardLink, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
          </TextBlock>
        </DockPanel>
      </Border>

      <!-- Sayfa değişince içerik hafifçe yukarı kayarak belirir -->
      <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding Current, NotifyOnTargetUpdated=True}" Focusable="False">
        <ContentControl.RenderTransform>
          <TranslateTransform />
        </ContentControl.RenderTransform>
        <ContentControl.Triggers>
          <EventTrigger RoutedEvent="Binding.TargetUpdated">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
                  <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </ContentControl.Triggers>
      </ContentControl>

      <!-- Bildirim: alttan kayarak gelir; fare üstündeyken kapanmaz -->
      <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,22" MaxWidth="680"
              Background="{DynamicResource Invert}" CornerRadius="12" Padding="16,5,5,5"
              Visibility="{Binding Toast, Converter={StaticResource Vis}}" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.25" Color="#000000" />
        </Border.Effect>
        <Border.RenderTransform>
          <TranslateTransform />
        </Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Binding.TargetUpdated">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.25">
                  <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource ToastBtn}" Foreground="{DynamicResource InvertInk}" Padding="0" Width="30"
                  Command="{Binding DismissToastCommand}" ToolTip="Kapat" AutomationProperties.Name="Bildirimi kapat">
            <c:Icon Data="{StaticResource I.X}" Size="13" />
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource ToastBtn}" Margin="10,0,2,0" Content="{Binding Toast.ActionLabel}"
                  Command="{Binding ToastActionCommand}" Visibility="{Binding Toast.ActionLabel, Converter={StaticResource Vis}}" />
          <TextBlock Text="{Binding Toast.Text, NotifyOnTargetUpdated=True}" Foreground="{DynamicResource InvertInk}" FontSize="14" FontWeight="Medium"
                     VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============ Sürükle-bırak katmanı (sürükleme pencereye girince görünür) ============ -->
    <Grid x:Name="DropLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#B3101115" AllowDrop="True" Visibility="Collapsed"
          DragLeave="DropLayer_DragLeave">
      <Border IsHitTestVisible="False" Width="440" Padding="30" CornerRadius="18" Background="{DynamicResource Surface}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Rectangle Stroke="{DynamicResource AccentStrong}" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="12" RadiusY="12" Margin="-16" />
          <StackPanel>
            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
              <c:Icon Data="{StaticResource I.Download}" Size="24" Thickness="2.2" Foreground="{DynamicResource AccentStrong}" />
            </Border>
            <TextBlock Style="{StaticResource H2}" TextAlignment="Center" Margin="0,14,0,6" Text="Bırak, Vidra açsın" />
            <TextBlock Style="{StaticResource Body2}" TextAlignment="Center" LineHeight="19"
                       Text="Video, playlist ya da kanal bağlantısı; .url ya da .txt dosyası. Birden çok video doğrudan kuyruğa eklenir." />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ Komut paleti (Ctrl+K) ============ -->
    <Grid x:Name="PaletteLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#73101115" DataContext="{Binding Palette}"
          Visibility="{Binding IsOpen, Converter={StaticResource Vis}}" MouseLeftButtonDown="PaletteBackdrop_MouseDown"
          KeyboardNavigation.TabNavigation="Cycle">
      <Border Style="{StaticResource Card}" Width="680" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="20,84,20,40" CornerRadius="16">
        <Border.Effect>
          <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.28" Color="#000000" />
        </Border.Effect>
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,6,10,6">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Kbd}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Esc" /></Border>
              <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Search}" Size="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
              <TextBox x:Name="PaletteBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                       FontSize="16" Padding="10,0" MinHeight="40" Tag="Sayfa, eylem, geçmiş ya da bağlantı…"
                       AutomationProperties.Name="Komut ara" PreviewKeyDown="PaletteBox_PreviewKeyDown" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,7"
                  TextElement.FontSize="12.5" TextElement.Foreground="{DynamicResource Muted}">
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Kbd}"><TextBlock Text="↑↓" /></Border>
              <TextBlock Text="gez" VerticalAlignment="Center" Margin="2,0,14,0" />
              <Border Style="{StaticResource Kbd}"><TextBlock Text="Enter" /></Border>
              <TextBlock Text="çalıştır" VerticalAlignment="Center" Margin="2,0,14,0" />
              <TextBlock Text="Bağlantı yapıştırırsan açar, yazdığını YouTube'da arar." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Grid>
            <ListBox x:Name="PaletteList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource PaletteItem}"
                     Background="Transparent" BorderThickness="0" Padding="0,6" MaxHeight="430" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Background="Transparent">
                    <DockPanel.InputBindings>
                      <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.RunCommand, ElementName=PaletteLayer}" CommandParameter="{Binding}" />
                    </DockPanel.InputBindings>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Kbd}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Shortcut, Converter={StaticResource Vis}}">
                      <TextBlock Text="{Binding Shortcut}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" Style="{StaticResource Small}" Margin="10,0,2,0" VerticalAlignment="Center"
                               Visibility="{Binding Shortcut, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Raised}" Margin="0,0,12,0">
                      <c:Icon Data="{Binding Icon, Converter={StaticResource IconKey}}" Size="15" Foreground="{DynamicResource Text2}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                 Visibility="{Binding Subtitle, Converter={StaticResource Vis}}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Style="{StaticResource Body2}" Margin="20,18" Text="Eşleşen bir şey yok."
                       Visibility="{Binding Items.Count, Converter={StaticResource Vis}, ConverterParameter=!}" />
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============ İlk kurulum katmanı ============ -->
    <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#99101115" DataContext="{Binding Setup}"
          Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
      <Border Style="{StaticResource Card}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel>
          <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,16">
            <c:Icon Data="{StaticResource I.Download}" Size="22" Thickness="2.4" Foreground="{DynamicResource AccentInk}" />
          </Border>
          <TextBlock Style="{StaticResource H2}" FontSize="23" Text="Vidra'ya hoş geldin" />
          <TextBlock Style="{StaticResource Body2}" Margin="0,8,0,16" Text="{Binding Message}" />
          <StackPanel Margin="0,0,0,18">
            <TextBlock FontSize="14" Margin="0,0,0,4"><Run Text="yt-dlp" FontWeight="SemiBold" /><Run Text=" — indirme motoru" Foreground="{DynamicResource Text2}" /></TextBlock>
            <TextBlock FontSize="14" Margin="0,0,0,4"><Run Text="ffmpeg" FontWeight="SemiBold" /><Run Text=" — video/ses birleştirme ve dönüştürme" Foreground="{DynamicResource Text2}" /></TextBlock>
            <TextBlock FontSize="14"><Run Text="Deno" FontWeight="SemiBold" /><Run Text=" — YouTube'un JavaScript doğrulamalarını çözer" Foreground="{DynamicResource Text2}" /></TextBlock>
          </StackPanel>
          <ProgressBar Maximum="1" Value="{Binding Fraction, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Margin="0,0,0,16"
                       Visibility="{Binding Busy, Converter={StaticResource Vis}}" />
          <Border Style="{StaticResource Notice}" Margin="0,0,0,16" Visibility="{Binding Error, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="14" />
          </Border>
          <Button Style="{StaticResource BtnPrimaryLg}" HorizontalAlignment="Left" Command="{Binding InstallCommand}"
                  IsEnabled="{Binding Busy, Converter={StaticResource Not}}" Content="Bileşenleri indir (~150 MB)" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
