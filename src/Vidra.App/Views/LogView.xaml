<UserControl x:Class="Vidra.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vidra.App.Controls"
             x:Name="Root">
  <UserControl.Resources>
    <!-- Soldaki iş listesi: seçili satır vurgulu -->
    <Style x:Key="JobItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9" Margin="0,0,0,4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PagePadFill}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Başlık: kuyruğa dön · ad · açıklama -->
    <DockPanel Margin="0,0,0,18">
      <Button DockPanel.Dock="Left" Style="{StaticResource BtnGhostIcon}" Width="36" Height="36" MinHeight="36" VerticalAlignment="Top" Margin="-8,0,8,0"
              Command="{Binding BackCommand}" ToolTip="Kuyruğa dön" AutomationProperties.Name="Kuyruğa dön">
        <c:Icon Data="{StaticResource I.ArrowRight}" Size="18" RenderTransformOrigin="0.5,0.5">
          <c:Icon.RenderTransform><ScaleTransform ScaleX="-1" /></c:Icon.RenderTransform>
        </c:Icon>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="İndirme günlüğü" />
        <TextBlock Style="{StaticResource Body2}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                   Text="yt-dlp'nin ham çıktısı. Bir indirme takılır ya da hata verirse sebebi burada yazar; kopyalayıp hata bildirimine ekleyebilirsin. Yalnızca kuyruktaki işler için tutulur." />
      </StackPanel>
    </DockPanel>

    <!-- Kuyruk boş -->
    <Border Grid.Row="1" Style="{StaticResource Tile}" Padding="18" VerticalAlignment="Top"
            Visibility="{Binding Queue.Jobs.Count, Converter={StaticResource Vis}, ConverterParameter=!}">
      <TextBlock Style="{StaticResource Body2}" Text="Kuyrukta iş yok. Bir indirme başlayınca günlüğü burada görünür." />
    </Border>

    <Grid Grid.Row="1" Visibility="{Binding Queue.Jobs.Count, Converter={StaticResource Vis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- İşler -->
      <ListBox ItemsSource="{Binding Queue.Jobs}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource JobItem}" Margin="0,0,18,0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Kuyruktaki işler">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
              <TextBlock Text="{Binding Stage}" Style="{StaticResource Small}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Seçili işin günlüğü -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" DataContext="{Binding Selected}"
              Visibility="{Binding Converter={StaticResource Vis}}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource BtnSm}" Margin="0,0,8,0" ToolTip="Günlüğü panoya kopyala"
                      Command="{Binding DataContext.QueueVm.CopyLogCommand, ElementName=Root}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Copy}" Size="14" Margin="0,0,6,0" /><TextBlock Text="Kopyala" /></StackPanel>
              </Button>
              <Button Style="{StaticResource BtnSm}" Content="Komutu kopyala" ToolTip="Bu işin yt-dlp komut satırını kopyala (çerez yolu gizlenir)"
                      Command="{Binding DataContext.QueueVm.CopyCommandCommand, ElementName=Root}" CommandParameter="{Binding}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
              <TextBlock Style="{StaticResource Small}" Margin="0,3,0,0">
                <Run Text="{Binding Stage, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Options, Mode=OneWay, Converter={StaticResource Desc}}" />
              </TextBlock>
            </StackPanel>
          </DockPanel>
          <TextBox Text="{Binding Log.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                   VerticalContentAlignment="Top" Padding="10,8" Background="{DynamicResource Surface2}" Foreground="{DynamicResource Text2}"
                   VerticalScrollBarVisibility="Auto" TextChanged="Log_TextChanged" AutomationProperties.Name="yt-dlp günlüğü" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
