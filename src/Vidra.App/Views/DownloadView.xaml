<UserControl x:Class="Vidra.App.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vidra.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,14,20,24" MaxWidth="960">

      <!-- ===== Tek kutu: bağlantı yapıştır ya da ara ===== -->
      <Border Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="12" Padding="12,5,5,5">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Style.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
            <c:Icon Data="{StaticResource I.Link}" Foreground="{DynamicResource Muted}" Visibility="{Binding IsQuery, Converter={StaticResource Vis}, ConverterParameter=!}" />
            <c:Icon Data="{StaticResource I.Search}" Foreground="{DynamicResource Muted}" Visibility="{Binding IsQuery, Converter={StaticResource Vis}}" />
          </Grid>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" MinHeight="36" MinWidth="96" Command="{Binding AnalyzeCommand}" AutomationProperties.Name="Getir">
            <Grid>
              <TextBlock Text="Getir" Visibility="{Binding IsQuery, Converter={StaticResource Vis}, ConverterParameter=!}" />
              <TextBlock Text="Ara" Visibility="{Binding IsQuery, Converter={StaticResource Vis}}" />
            </Grid>
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhostIcon}" Command="{Binding PasteCommand}" Margin="0,0,6,0"
                  ToolTip="Panodan yapıştır (Ctrl+V)" AutomationProperties.Name="Panodan yapıştır">
            <c:Icon Data="{StaticResource I.Clipboard}" />
          </Button>
          <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="12,0"
                   FontSize="14" Tag="Bağlantı yapıştır ya da YouTube'da ara"
                   AutomationProperties.Name="YouTube bağlantısı ya da arama" DataObject.Pasting="UrlBox_Pasting">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding AnalyzeCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </DockPanel>
      </Border>

      <!-- ===== Bu video bir playlistin parçası ===== -->
      <Border Margin="0,12,0,0" Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="16,4,8,4"
              Visibility="{Binding PlaylistUrl, Converter={StaticResource Vis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Command="{Binding LoadPlaylistCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Tüm listeyi aç" />
              <c:Icon Data="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Playlist}" Size="16" Foreground="{DynamicResource AccentStrong}" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Text="Bu video bir playlistin parçası." VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource Vis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="Hesabım'a git" Command="{Binding OpenAccountCommand}"
                  Visibility="{Binding ErrorIsAuth, Converter={StaticResource Vis}}" />
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Margin="10,0,0,0" Command="{Binding EnqueueWhenLiveCommand}"
                  Visibility="{Binding UpcomingUrl, Converter={StaticResource Vis}}" ToolTip="Kuyruğa alınır; yt-dlp yayının başlamasını bekleyip indirir">
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Bell}" Size="13" Margin="0,0,6,0" /><TextBlock Text="Başlayınca indir" /></StackPanel>
          </Button>
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
      </Border>

      <!-- ===== Boş durum: çerçevesiz, yalnızca ne yapılacağı ===== -->
      <StackPanel Margin="0,72,0,0" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Raised}" HorizontalAlignment="Center">
          <c:Icon Data="{StaticResource I.Download}" Size="24" Thickness="1.8" Foreground="{DynamicResource Text2}" />
        </Border>
        <TextBlock Style="{StaticResource H2}" TextAlignment="Center" Margin="0,16,0,6" Text="Bir bağlantı yapıştır" />
        <TextBlock Style="{StaticResource Body2}" TextAlignment="Center" MaxWidth="400" Foreground="{DynamicResource Muted}" LineHeight="19"
                   Text="Video, Shorts, playlist, kanal ya da canlı yayın. Bağlantı değilse YouTube'da aranır; birden çok bağlantı hepsini kuyruğa alır." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Muted}">
          <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl" /></Border>
          <Border Style="{StaticResource Kbd}"><TextBlock Text="V" /></Border>
          <TextBlock Text="yapıştır ve getir" VerticalAlignment="Center" Margin="4,0,20,0" />
          <Border Style="{StaticResource Kbd}"><TextBlock Text="Enter" /></Border>
          <TextBlock Text="getir ya da ara" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Muted}">
          <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl" /></Border>
          <Border Style="{StaticResource Kbd}"><TextBlock Text="K" /></Border>
          <TextBlock Text="komut paleti" VerticalAlignment="Center" Margin="4,0,20,0" />
          <c:Icon Data="{StaticResource I.Link}" Size="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
          <TextBlock Text="bağlantıyı pencereye sürükle-bırak" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Son indirilenler: farklı kalitede yeniden açmak ya da oynatmak için kısa yol -->
        <StackPanel Margin="0,40,0,0" Width="600" Visibility="{Binding Recent.Count, Converter={StaticResource Vis}}">
          <TextBlock Style="{StaticResource Eyebrow}" Text="Son indirilenler" Margin="6,0,0,8" />
          <Border Style="{StaticResource Card}" CornerRadius="14" Padding="4">
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="10" Padding="8,6">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Surface2}" /></Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnSm}" Content="Oynat" Margin="8,0,6,0" CommandParameter="{Binding}"
                                Visibility="{Binding FilePath, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.QueueVm.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Style="{StaticResource BtnSm}" Content="Yeniden aç" CommandParameter="{Binding}" ToolTip="Farklı kalite ya da biçimle indirmek için analiz et"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      </StackPanel>
                      <Border DockPanel.Dock="Left" Width="64" Height="36" CornerRadius="5" Background="{DynamicResource ThumbBg}" Margin="0,0,12,0">
                        <Border.Clip><RectangleGeometry Rect="0,0,64,36" RadiusX="5" RadiusY="5" /></Border.Clip>
                        <Image Source="{Binding ThumbUrl, Converter={StaticResource Thumb}, ConverterParameter=160}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                          <Run Text="{Binding Channel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Options, Mode=OneWay, Converter={StaticResource Desc}}" /><Run Text=" · " /><Run Text="{Binding FinishedAt, Mode=OneWay, Converter={StaticResource Rel}}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- ===== Yükleniyor ===== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="176" Height="99" CornerRadius="10" Background="{DynamicResource Raised}" />
          <StackPanel Margin="18,4,0,0">
            <Border Height="20" CornerRadius="6" Background="{DynamicResource Raised}" Margin="0,0,80,10" />
            <Border Height="20" CornerRadius="6" Background="{DynamicResource Raised}" Margin="0,0,220,14" />
            <Border Height="12" Width="200" HorizontalAlignment="Left" CornerRadius="6" Background="{DynamicResource Raised}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===== Video kartı ===== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
        <StackPanel>

          <!-- Başlık: kapak + ad + kanal -->
          <DockPanel Margin="16,16,16,0">
            <Grid DockPanel.Dock="Left" Width="176" Height="99" VerticalAlignment="Top">
              <Border x:Name="ThumbMask" CornerRadius="10" Background="{DynamicResource ThumbBg}" />
              <Image Source="{Binding Info.Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=360}" Stretch="UniformToFill">
                <Image.OpacityMask><VisualBrush Visual="{Binding ElementName=ThumbMask}" /></Image.OpacityMask>
              </Image>
              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#D914171C" CornerRadius="5" Padding="5,1">
                <TextBlock Text="{Binding Info.Duration, Converter={StaticResource Dur}}" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" />
              </Border>
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="{DynamicResource Danger}" CornerRadius="5" Padding="6,1"
                      Visibility="{Binding Info.Live, Converter={StaticResource Vis}}">
                <TextBlock Text="CANLI" Foreground="White" FontSize="10.5" FontWeight="Bold" />
              </Border>
            </Grid>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Info.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                         LineHeight="24" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Info.Title}" />
              <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Info.Channel, Mode=OneWay}" Foreground="{DynamicResource Text2}" FontWeight="Medium" /><Run Text="  ·  " /><Run Text="{Binding MetaViews, Mode=OneWay}" /><Run Text=" görüntülenme  ·  " /><Run Text="{Binding MetaUpload, Mode=OneWay}" />
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding Info.MembersOnly, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource ChipGold}"><TextBlock Text="ÜYELERE ÖZEL" /></Border>
                <TextBlock Text="Üyeliğin doğrulandı" Foreground="{DynamicResource Ok}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </DockPanel>

          <!-- Seçim: üst satırda video/ses ve biçim, altında kalite ya da ses biçimi kartları -->
          <StackPanel Margin="16,18,16,6">
            <DockPanel LastChildFill="False">
              <ListBox DockPanel.Dock="Left" Style="{StaticResource Segmented}" ItemsSource="{Binding ModeChoices}" SelectedValue="{Binding Mode}" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Video}">
                <TextBlock Style="{StaticResource Eyebrow}" Text="Biçim" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Containers}" SelectedValue="{Binding Container}"
                         ToolTip="Orijinal: kodek ve kap zorlanmaz, YouTube'daki en iyi akışlar alınır. MP4: en uyumlu (H.264 + AAC tercih edilir)." />
              </StackPanel>
            </DockPanel>

            <!-- VIDEO: en yüksek kart "en iyi"dir -->
            <ListBox Style="{StaticResource OptionList}" Margin="0,14,0,0" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}"
                     Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Video}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding Hint}">
                    <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Title, Mode=OneWay}" FontSize="15" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding Tag, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentStrong}" /></TextBlock>
                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- SES -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Audio}">
              <ListBox Style="{StaticResource OptionList}" ItemsSource="{Binding AudioCards}" SelectedItem="{Binding SelectedAudio}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel ToolTip="{Binding Detail}">
                      <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Title, Mode=OneWay}" FontSize="15" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding SizeText, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource Text2}" /></TextBlock>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <CheckBox IsChecked="{Binding MusicMode}" Margin="2,2,0,0" HorizontalAlignment="Left"
                        ToolTip="Kare kapak, “- Topic” eki temizlenmiş sanatçı adı; MP3/FLAC/WAV'da ses yüksekliği eşitleme. Playlist'ten inince albüm ve parça no.">
                <TextBlock><Run Text="Müzik modu" FontWeight="Medium" /><Run Text="  kare kapak, sanatçı/albüm etiketleri" Foreground="{DynamicResource Muted}" FontSize="12" /></TextBlock>
              </CheckBox>
            </StackPanel>

            <!-- Ses dili: çok dilli (dublajlı) videolarda -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,8" Visibility="{Binding HasAudioLanguages, Converter={StaticResource Vis}}">
              <c:Icon Data="{StaticResource I.Music}" Size="15" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Ses dili" FontSize="13" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ComboBox Width="270" ItemsSource="{Binding AudioLanguageChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectedValue="{Binding AudioLanguage}" AutomationProperties.Name="Ses dili"
                        ToolTip="YouTube'un dublaj izleri: seçilen dil yoksa orijinal ses iner" />
              <TextBlock Text="{Binding AudioLanguageHint}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <!-- Süren canlı yayın: şu andan değil baştan kaydet -->
            <CheckBox IsChecked="{Binding LiveFromStart}" Margin="2,0,0,8" HorizontalAlignment="Left" Visibility="{Binding Info.Live, Converter={StaticResource Vis}}"
                      ToolTip="--live-from-start: yayının başından itibaren kaydeder (YouTube'da deneysel, yavaş olabilir)">
              <TextBlock><Run Text="Baştan kaydet" FontWeight="Medium" /><Run Text="  canlı yayını şu andan değil, başından indir" Foreground="{DynamicResource Muted}" FontSize="12" /></TextBlock>
            </CheckBox>

            <!-- Dönüştürme: kopyalanıyorsa sakin bir satır, yeniden kodlanıyorsa dikkat çeken kutu -->
            <Border CornerRadius="10">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Padding" Value="2,2" />
                  <Setter Property="Margin" Value="0,2,0,0" />
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Text2}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLossless}" Value="False">
                      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
                      <Setter Property="Padding" Value="12,9" />
                      <Setter Property="Margin" Value="0,6,0,0" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <DockPanel>
                <Grid DockPanel.Dock="Left" Margin="0,0,9,0" VerticalAlignment="Top">
                  <c:Icon Data="{StaticResource I.Check}" Size="16" Thickness="2.4" Foreground="{DynamicResource Ok}" Visibility="{Binding IsLossless, Converter={StaticResource Vis}}" />
                  <c:Icon Data="{StaticResource I.Info}" Size="16" Visibility="{Binding IsLossless, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </Grid>
                <TextBlock Text="{Binding ConversionText}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <!-- ===== Diğer seçenekler (varsayılan kapalı) ===== -->
            <ToggleButton Style="{StaticResource Disclosure}" IsChecked="{Binding ShowMore}" Margin="0,10,0,0" Content="Diğer seçenekler" Tag="{Binding MoreSummary}" />
            <StackPanel Margin="0,6,0,6" Visibility="{Binding ShowMore, Converter={StaticResource Vis}}">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowMore}" Value="True">
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <!-- Video: kodek ve kare hızı -->
              <WrapPanel Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Video}">
                <StackPanel Margin="0,0,24,16">
                  <TextBlock Style="{StaticResource Eyebrow}" Text="Kodek" Margin="0,0,0,8" />
                  <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Codecs}" SelectedValue="{Binding Codec}"
                           ToolTip="Otomatik: Orijinal/MKV'de YouTube'un en iyisi (çoğu zaman AV1), MP4'te H.264. Kodek tercihi çözünürlüğü düşürmez." />
                </StackPanel>
                <StackPanel Margin="0,0,24,16">
                  <TextBlock Style="{StaticResource Eyebrow}" Text="Kare hızı" Margin="0,0,0,8" />
                  <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding FpsChoices}" SelectedValue="{Binding MaxFps30}" />
                </StackPanel>
              </WrapPanel>

              <!-- Anahtarlar: tek bir grup kutusunda, kart içinde kart yok -->
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="4">
                <ItemsControl>
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:UniformWrapPanel MinItemWidth="340" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Subtitles}" Content="Altyazı" Tag="{Binding SubsInfo}" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ClipEnabled}" Content="Klip kes" Tag="{Binding ClipHint}" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding SponsorBlock}" Content="SponsorBlock" Tag="{Binding SponsorHint}" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding EmbedThumbnail}" Content="Kapak &amp; etiketler" Tag="Kapak, başlık, sanatçı, tarih" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Chapters}" Content="Bölüm işaretleri" Tag="Oynatıcıda bölümler görünsün" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding SplitChapters}" Content="Bölümlere ayır" Tag="Her bölüm ayrı dosya" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding UseArchive}" Content="Arşive kaydet" Tag="Aynı video ikinci kez inmesin" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Transcript}" Content="Metin döküm" Tag="Altyazıdan zaman damgasız .txt (altyazı dillerinde)" />
                  <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Comments}" Content="Yorumlar" Tag="Yorumlar .info.json dosyasına yazılır" />
                </ItemsControl>
              </Border>

              <!-- Altyazı dilleri -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding Subtitles, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Eyebrow}" Text="Altyazı dilleri" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SubtitleLangs}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton Style="{StaticResource Pill}" IsChecked="{Binding IsOn}">
                        <TextBlock><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Hint, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Muted}" /></TextBlock>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Klip -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding ClipEnabled, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Eyebrow}" Text="Klip" Margin="0,0,0,8" />
                <WrapPanel>
                  <HeaderedContentControl Style="{StaticResource Field}" Header="Başlangıç">
                    <TextBox Style="{StaticResource InputMono}" Width="110" Text="{Binding ClipStart, UpdateSourceTrigger=PropertyChanged}" Tag="2:15" />
                  </HeaderedContentControl>
                  <HeaderedContentControl Style="{StaticResource Field}" Header="Bitiş">
                    <TextBox Style="{StaticResource InputMono}" Width="110" Text="{Binding ClipEnd, UpdateSourceTrigger=PropertyChanged}" Tag="5:40" />
                  </HeaderedContentControl>
                  <HeaderedContentControl Style="{StaticResource Field}" Header="ya da bölüm seç" Visibility="{Binding Info.Chapters.Count, Converter={StaticResource Vis}}">
                    <ComboBox Width="280" ItemsSource="{Binding Info.Chapters}" SelectedItem="{Binding SelectedChapter}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Start, Mode=OneWay, Converter={StaticResource Dur}}" Foreground="{DynamicResource Muted}" /><Run Text="–" Foreground="{DynamicResource Muted}" /><Run Text="{Binding End, Mode=OneWay, Converter={StaticResource Dur}}" Foreground="{DynamicResource Muted}" /></TextBlock>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </HeaderedContentControl>
                </WrapPanel>
                <!-- Ek aralıklar (çoklu kesim): her biri ayrı dosya -->
                <ItemsControl ItemsSource="{Binding ExtraClips}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource InputMono}" Width="110" Margin="0,0,14,0" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Tag="1:00"
                                 AutomationProperties.Name="Aralık başlangıcı" />
                        <TextBox Style="{StaticResource InputMono}" Width="110" Margin="0,0,6,0" Text="{Binding End, UpdateSourceTrigger=PropertyChanged}" Tag="1:30"
                                 AutomationProperties.Name="Aralık bitişi" />
                        <Button Style="{StaticResource BtnGhostIcon}" Width="34" ToolTip="Aralığı kaldır" AutomationProperties.Name="Aralığı kaldır" CommandParameter="{Binding}"
                                Command="{Binding DataContext.RemoveClipRangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                          <c:Icon Data="{StaticResource I.X}" Size="13" />
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,0,0,10">
                  <Button Style="{StaticResource BtnSm}" Command="{Binding AddClipRangeCommand}" Margin="0,0,16,6" ToolTip="Bir aralık daha: her aralık ayrı dosya olarak iner">
                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Plus}" Size="13" Margin="0,0,6,0" /><TextBlock Text="Aralık ekle" /></StackPanel>
                  </Button>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding HasHeatmap, Converter={StaticResource Vis}}">
                    <TextBlock Text="En çok izlenen:" FontSize="12.5" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Style="{StaticResource BtnSm}" Content="30 sn" Margin="0,0,6,0" Command="{Binding PickHighlightsCommand}" CommandParameter="30"
                            ToolTip="YouTube'da en çok tekrar oynatılan 30 saniye" />
                    <Button Style="{StaticResource BtnSm}" Content="1 dk" Margin="0,0,6,0" Command="{Binding PickHighlightsCommand}" CommandParameter="60"
                            ToolTip="YouTube'da en çok tekrar oynatılan 1 dakika" />
                    <Button Style="{StaticResource BtnSm}" Content="En iyi 3 an" Command="{Binding PickHighlightsCommand}" CommandParameter="3x20"
                            ToolTip="Birbiriyle çakışmayan en çok izlenen üç an, 20'şer saniye; her biri ayrı klip" />
                  </StackPanel>
                </WrapPanel>

                <!-- "En çok tekrar oynatılan" grafiği ve seçili aralıklar (1000 birimlik tuval genişliğe yayılır) -->
                <Viewbox Stretch="Fill" Height="50" ToolTip="YouTube'un “en çok tekrar oynatılan” grafiği; renkli bölgeler indirilecek aralıklar">
                  <Grid Width="1000" Height="50">
                    <Border VerticalAlignment="Bottom" Height="6" CornerRadius="3" Background="{DynamicResource Raised}" />
                    <Canvas Width="1000" Height="40" VerticalAlignment="Top" Visibility="{Binding HasHeatmap, Converter={StaticResource Vis}}">
                      <Polygon Points="{Binding HeatPoints}" Fill="{DynamicResource Line2}" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                    </Canvas>
                    <ItemsControl ItemsSource="{Binding ClipBars}" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                          <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Width="{Binding Width}" Height="50">
                            <Border Height="40" VerticalAlignment="Top" Background="{DynamicResource Accent}" Opacity="0.28" />
                            <Border Height="6" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" CornerRadius="3" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Viewbox>
                <TextBlock Text="{Binding ClipText}" Style="{StaticResource Small}" Margin="0,8,0,10" />
                <CheckBox IsChecked="{Binding ClipPrecise}" HorizontalAlignment="Left"
                          ToolTip="Kapalıyken en yakın anahtar karede, kopyalayarak keser: hızlıdır, kalite kaybı yoktur ama birkaç saniye erken başlayabilir.">
                  <TextBlock><Run Text="Kesin kesim" FontWeight="Medium" /><Run Text="  kare hassasiyetinde; videoyu yeniden kodlar (yavaş)" Foreground="{DynamicResource Muted}" FontSize="12" /></TextBlock>
                </CheckBox>
              </StackPanel>

              <!-- SponsorBlock kategorileri -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding SponsorBlock, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Eyebrow}" Text="Kesilecek bölümler (genel ayar)" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SponsorCats}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><ToggleButton Style="{StaticResource Pill}" IsChecked="{Binding IsOn}" Content="{Binding Label}" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Hazır ayarlar: tek tıkla biçim seti; kullanıcınınkiler × ile silinir -->
              <TextBlock Style="{StaticResource Eyebrow}" Text="Hazır ayarlar" Margin="0,16,0,8" />
              <WrapPanel>
                <ItemsControl ItemsSource="{Binding Profiles}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                        <Button Style="{StaticResource BtnSm}" Padding="12,0" Content="{Binding Name}"
                                Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource BtnGhostIcon}" Width="24" Height="24" MinHeight="24" Margin="2,0,0,0" ToolTip="Hazır ayarı sil"
                                Visibility="{Binding BuiltIn, Converter={StaticResource Vis}, ConverterParameter=!}"
                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                          <c:Icon Data="{StaticResource I.X}" Size="12" />
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ToggleButton Style="{StaticResource Pill}" IsChecked="{Binding SavingProfile}" Margin="0,0,8,8" ToolTip="Şu anki seçimleri hazır ayar olarak kaydet">
                  <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Plus}" Size="13" Margin="0,0,6,0" /><TextBlock Text="Kaydet" /></StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding SavingProfile, Converter={StaticResource Vis}}">
                  <TextBox Width="180" MinHeight="30" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" Tag="Ad" Margin="0,0,8,0">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveProfileCommand}" /></TextBox.InputBindings>
                  </TextBox>
                  <Button Style="{StaticResource BtnSm}" Content="Ekle" Command="{Binding SaveProfileCommand}" />
                </StackPanel>
              </WrapPanel>

              <!-- Teknik ayrıntı: indirilecek akışlar -->
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,8,0,0">
                <StackPanel>
                  <Grid Margin="12,8,12,4" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontSize="11.5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Akış" /><TextBlock Grid.Column="1" Text="ID" /><TextBlock Grid.Column="2" Text="Ayrıntı" />
                    <TextBlock Grid.Column="3" Text="Bit hızı" /><TextBlock Grid.Column="4" Text="Boyut" TextAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding StreamRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource Raised}" BorderThickness="0,1,0,0" Padding="12,7">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="56" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Cell}" FontSize="12" FontWeight="Medium" Text="{Binding Kind}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CellMono}" Text="{Binding Id}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource CellMono}" Text="{Binding Detail}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource CellMono}" Text="{Binding Rate}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource CellMono}" Text="{Binding Size}" TextAlignment="Right" Margin="0" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- ===== Eylem çubuğu: nereye kaydedilecek (tıkla → değiştir) + kuyruğa ekle + indir ===== -->
          <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="8,10,16,10" Margin="0,8,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimaryLg}" Command="{Binding DownloadNowCommand}" MinWidth="150">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource I.Download}" Size="17" Thickness="2.4" Margin="0,0,10,0" />
                  <TextBlock><Run Text="İndir ·" /> <Run Text="{Binding Estimate, Mode=OneWay}" /></TextBlock>
                </StackPanel>
              </Button>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnLg}" Margin="0,0,10,0" Command="{Binding AddToQueueCommand}"
                      ToolTip="Şimdi başlatmadan kuyruğa ekle" AutomationProperties.Name="Kuyruğa ekle">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource I.Plus}" Size="15" Margin="0,0,8,0" />
                  <TextBlock Text="Kuyruğa ekle" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource BtnFlat}" Command="{Binding PickFolderCommand}" Margin="0,0,12,0"
                      ToolTip="Kayıt klasörünü değiştir" AutomationProperties.Name="Kayıt klasörünü değiştir">
                <DockPanel>
                  <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Folder}" Foreground="{DynamicResource AccentStrong}" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <StackPanel>
                    <TextBlock Text="{Binding OutputDir}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FilePreview}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                  </StackPanel>
                </DockPanel>
              </Button>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
