<UserControl x:Class="Vidra.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vidra.App.Controls"
             x:Name="Root">
  <Grid Margin="{StaticResource PagePadFill}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource H1}" Text="Kütüphane" />
      <TextBlock Style="{StaticResource Body2}" HorizontalAlignment="Left" Margin="0,4,0,12"
                 Text="İndirdiğin ve hâlâ diskte duran dosyalar. Çift tıkla oynat, sağ tıkla diğer işlemler; kartı bir klasöre ya da uygulamaya sürükleyip bırakabilirsin." />
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,0,4,0" Width="280" Height="36" Margin="0,0,10,8">
        <DockPanel>
          <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Search}" Size="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}" BorderThickness="0" Background="Transparent" Padding="8,0"
                   VerticalContentAlignment="Center" Tag="Başlık veya kanal  (Ctrl+F)" AutomationProperties.Name="Kütüphanede ara" />
        </DockPanel>
      </Border>
      <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Filters}" SelectedValue="{Binding Filter}" Margin="0,0,10,8" VerticalAlignment="Center" />
      <ComboBox Width="150" ItemsSource="{Binding Sorts}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sort}" Margin="0,0,12,8"
                ToolTip="Sıralama" AutomationProperties.Name="Sıralama" />
      <TextBlock Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,0,8">
        <Run Text="{Binding Count, Mode=OneWay}" /> dosya · <Run Text="{Binding TotalSize, Mode=OneWay, Converter={StaticResource Bytes}}" />
      </TextBlock>
    </WrapPanel>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards.Rows}" Style="{StaticResource VirtualList}" SizeChanged="Cards_SizeChanged">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.Cards.Columns, ElementName=Root}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,16,16" Padding="10" CornerRadius="14" BorderThickness="1" Background="{DynamicResource Surface}"
                        Tag="{Binding DataContext.Actions, ElementName=Root}"
                        PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" MouseMove="Card_MouseMove">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Line2}" /></Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.Actions.OpenOrRevealCommand, ElementName=Root}" CommandParameter="{Binding}" />
                  </Border.InputBindings>
                  <!-- Menü ayrı bir görsel ağaçta: komutlara kartın Tag'indeki (Kuyruk ekranı) görünüm modeli üzerinden ulaşılır -->
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Oynat" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><c:Icon Data="{StaticResource I.Play}" Size="15" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Klasörde göster" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><c:Icon Data="{StaticResource I.Folder}" Size="15" /></MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Farklı kalitede indir…" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.ReopenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><c:Icon Data="{StaticResource I.Video}" Size="15" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Bağlantıyı kopyala" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><c:Icon Data="{StaticResource I.Link}" Size="15" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="YouTube'da aç" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><c:Icon Data="{StaticResource I.External}" Size="15" /></MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Geri dönüşüm kutusuna taşı" Style="{StaticResource MenuDanger}" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><c:Icon Data="{StaticResource I.Trash}" Size="15" /></MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel>
                    <Grid Height="{Binding DataContext.Cards.ThumbHeight, ElementName=Root}">
                      <Border x:Name="Mask" CornerRadius="8" Background="{DynamicResource ThumbBg}" />
                      <Image Source="{Binding ThumbUrl, Converter={StaticResource Thumb}, ConverterParameter=320}" Stretch="UniformToFill">
                        <Image.OpacityMask><VisualBrush Visual="{Binding ElementName=Mask}" /></Image.OpacityMask>
                      </Image>
                      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#D914171C" CornerRadius="6" Padding="6,2"
                              Visibility="{Binding Duration, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Duration, Converter={StaticResource Dur}}" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="#D914171C" CornerRadius="6" Padding="6,3"
                              Visibility="{Binding Options.Mode, Converter={StaticResource EqVis}, ConverterParameter=Audio}">
                        <c:Icon Data="{StaticResource I.Music}" Size="14" Foreground="White" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="32"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" Margin="2,8,2,0" ToolTip="{Binding Title}" />
                    <TextBlock Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0">
                      <Run Text="{Binding Channel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay, Converter={StaticResource Bytes}}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0">
                      <Run Text="{Binding Options, Mode=OneWay, Converter={StaticResource Desc}}" /><Run Text=" · " /><Run Text="{Binding FinishedAt, Mode=OneWay, Converter={StaticResource Rel}}" />
                    </TextBlock>
                    <WrapPanel Margin="0,8,0,0">
                      <Button Style="{StaticResource BtnSm}" Content="Oynat" Margin="0,0,6,0" CommandParameter="{Binding}"
                              Command="{Binding DataContext.Actions.OpenCommand, ElementName=Root}" />
                      <Button Style="{StaticResource BtnSm}" Content="Klasör" Margin="0,0,6,0" CommandParameter="{Binding}"
                              Command="{Binding DataContext.Actions.RevealCommand, ElementName=Root}" />
                      <Button Style="{StaticResource BtnSm}" Content="YouTube" CommandParameter="{Binding Url}"
                              Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Grid.Row="2" Style="{StaticResource Body2}" Margin="4" VerticalAlignment="Top"
               Text="Burada gösterilecek dosya yok. İndirdiğin videolar diskte durdukça burada görünür."
               Visibility="{Binding Count, Converter={StaticResource Vis}, ConverterParameter=!}" />
  </Grid>
</UserControl>
