<UserControl x:Class="Vidra.App.Views.BasketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vidra.App.Controls"
             x:Name="Root">
  <Grid Margin="{StaticResource PagePadFill}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="Sepeti boşalt" Command="{Binding ClearCommand}" VerticalAlignment="Center"
              Visibility="{Binding Items.Count, Converter={StaticResource Vis}}" />
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="Sepet" />
        <TextBlock Style="{StaticResource Body2}" HorizontalAlignment="Left" Margin="0,4,0,0"
                   Text="Farklı playlist, kanal ve aramalardan topladığın videolar. Biçimi aşağıda bir kez seç, hepsini birlikte indir." />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource Tile}" VerticalAlignment="Top" Visibility="{Binding Items.Count, Converter={StaticResource Vis}, ConverterParameter=!}">
      <TextBlock Style="{StaticResource Body2}" TextWrapping="Wrap"
                 Text="Sepet boş. Playlist &amp; kanal ekranında videoları ya da listeleri seçip &quot;Sepete ekle&quot;ye bas; aramada kartlardaki sepet düğmesini kullan." />
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="14" ClipToBounds="True" Visibility="{Binding Items.Count, Converter={StaticResource Vis}}">
      <ItemsControl ItemsSource="{Binding Items}" Style="{StaticResource VirtualList}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource Raised}" BorderThickness="0,0,0,1" Padding="16,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="80" Height="45" CornerRadius="6" Background="{DynamicResource ThumbBg}" Margin="0,0,12,0">
                  <Border.Clip><RectangleGeometry Rect="0,0,80,45" RadiusX="6" RadiusY="6" /></Border.Clip>
                  <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=160}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                  <TextBlock Style="{StaticResource Small}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Channel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Source, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={StaticResource Dur}}" Style="{StaticResource CellMono}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource BtnGhostIcon}" Width="32" Height="32" MinHeight="32" ToolTip="YouTube'da aç" AutomationProperties.Name="YouTube'da aç"
                          Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}">
                    <c:Icon Data="{StaticResource I.External}" Size="14" />
                  </Button>
                  <Button Style="{StaticResource BtnGhostIcon}" Width="32" Height="32" MinHeight="32" ToolTip="Sepetten çıkar" AutomationProperties.Name="Sepetten çıkar"
                          Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource I.X}" Size="14" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- İndirme çubuğu: biçim burada bir kez seçilir -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="14" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line2}" BorderThickness="1" Visibility="{Binding Items.Count, Converter={StaticResource Vis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding DownloadAllCommand}" MinWidth="140">
          <StackPanel Orientation="Horizontal">
            <c:Icon Data="{StaticResource I.Download}" Size="16" Thickness="2.4" Margin="0,0,8,0" />
            <TextBlock Text="Hepsini indir" />
          </StackPanel>
        </Button>
        <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,20,0" />
        <WrapPanel VerticalAlignment="Center">
          <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Modes}" SelectedValue="{Binding Mode}" Margin="0,0,10,0" VerticalAlignment="Center" />
          <ComboBox Width="110" ItemsSource="{Binding Heights}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Height}" Margin="0,0,10,0"
                    ToolTip="Kalite" Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Video}" />
          <ComboBox Width="96" ItemsSource="{Binding AudioFormats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AudioFormat}" Margin="0,0,10,0"
                    ToolTip="Ses biçimi" Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Audio}" />
          <CheckBox Content="Müzik modu" IsChecked="{Binding MusicMode}" VerticalAlignment="Center" ToolTip="Kare kapak, ses eşitleme, sanatçı/albüm/parça etiketi"
                    Visibility="{Binding Mode, Converter={StaticResource EqVis}, ConverterParameter=Audio}" />
        </WrapPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
