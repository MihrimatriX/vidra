<UserControl x:Class="Vidra.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vidra.App.Controls"
             x:Name="Root">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,14,20,24" MaxWidth="1180">
      <TextBlock Style="{StaticResource H1}" Text="Ara" />
      <TextBlock Style="{StaticResource Body2}" HorizontalAlignment="Left" Margin="0,6,0,18"
                 Text="YouTube'da tarayıcı açmadan ara; sonuçları tek tıkla MP3 ya da video olarak kuyruğa al. Bağlantı yapıştırırsan doğrudan açılır." />

      <!-- Arama çubuğu -->
      <Border Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="12" Padding="12,5,5,5">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Style.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Search}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" MinHeight="36" MinWidth="96" Command="{Binding SearchCommand}" AutomationProperties.Name="Ara">
            <Grid>
              <TextBlock Text="Ara" Visibility="{Binding IsLoading, Converter={StaticResource Vis}, ConverterParameter=!}" />
              <TextBlock Text="Aranıyor…" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}" />
            </Grid>
          </Button>
          <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="12,0"
                   FontSize="15" Tag="Şarkı, sanatçı, konu ya da bağlantı…" AutomationProperties.Name="Arama">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="13" />
      </Border>

      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}" />

      <!-- Boş durum -->
      <StackPanel Margin="0,64,0,0" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
          <c:Icon Data="{StaticResource I.Search}" Size="22" Foreground="{DynamicResource AccentStrong}" />
        </Border>
        <TextBlock Style="{StaticResource H2}" TextAlignment="Center" Margin="0,16,0,6" Text="Ne dinlemek ya da izlemek istersin?" />
        <TextBlock Style="{StaticResource Body2}" TextAlignment="Center" MaxWidth="440"
                   Text="İlk 24 sonuç gelir. MP3 düğmesi müzik modunu kullanır: kare kapak, eşitlenmiş ses ve sanatçı etiketi." />
      </StackPanel>

      <!-- Sonuçlar -->
      <TextBlock Text="{Binding ResultInfo}" Style="{StaticResource Small}" Margin="2,20,0,12"
                 Visibility="{Binding Results.Count, Converter={StaticResource Vis}}" />
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><c:UniformWrapPanel MinItemWidth="250" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,14,14">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <Grid>
                  <!-- Yuvarlak köşe: Image'ı aynı boyuttaki yuvarlak kenarlıkla maskele (ImageBrush uzaktan inen resmi yenilemiyor) -->
                  <Border x:Name="Mask" Height="140" CornerRadius="10" Background="{DynamicResource ThumbBg}" />
                  <Image Height="140" Source="{Binding Entry.Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=480}" Stretch="UniformToFill">
                    <Image.OpacityMask><VisualBrush Visual="{Binding ElementName=Mask}" /></Image.OpacityMask>
                  </Image>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#D914171C" CornerRadius="6" Padding="6,2"
                          Visibility="{Binding Entry.Duration, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding DurationText}" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                  </Border>
                  <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="{DynamicResource Danger}" CornerRadius="6" Padding="7,2"
                          Visibility="{Binding IsLive, Converter={StaticResource Vis}}">
                    <TextBlock Text="CANLI" Foreground="White" FontSize="11" FontWeight="Bold" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           Height="38" Margin="2,10,2,2" ToolTip="{Binding Entry.Title}" />
                <Button Style="{StaticResource BtnLink}" Padding="0" MinHeight="18" HorizontalAlignment="Left" Margin="2,0,2,0" FontSize="12" FontWeight="Normal"
                        Foreground="{DynamicResource Text2}" Content="{Binding Entry.Channel}" ToolTip="Kanalı aç"
                        Visibility="{Binding Entry.ChannelUrl, Converter={StaticResource Vis}}"
                        Command="{Binding DataContext.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Entry.ChannelUrl}" />
                <TextBlock Text="{Binding Meta}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="2,0,2,10" />
                <Grid>
                  <TextBlock Text="Canlı yayın: seçeneklerle aç" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="2,0,0,0"
                             Visibility="{Binding IsLive, Converter={StaticResource Vis}}" />
                  <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Queued}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource BtnSm}" Command="{Binding DataContext.QuickAudioCommand, ElementName=Root}" CommandParameter="{Binding}"
                            Margin="0,0,6,0" ToolTip="Müzik modunda MP3 olarak kuyruğa ekle">
                      <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Music}" Size="14" Margin="0,0,6,0" /><TextBlock Text="MP3" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSm}" Command="{Binding DataContext.QuickVideoCommand, ElementName=Root}" CommandParameter="{Binding}"
                            Margin="0,0,6,0" ToolTip="Varsayılan video ayarlarıyla kuyruğa ekle">
                      <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Download}" Size="14" Margin="0,0,6,0" /><TextBlock Text="Video" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSm}" Command="{Binding DataContext.AddToBasketCommand, ElementName=Root}" CommandParameter="{Binding}"
                            IsEnabled="{Binding InBasket, Converter={StaticResource Not}}" Margin="0,0,6,0" ToolTip="Sepete ekle" AutomationProperties.Name="Sepete ekle">
                      <c:Icon Data="{StaticResource I.Basket}" Size="14" />
                    </Button>
                  </StackPanel>
                  <Border Style="{StaticResource ChipOk}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,5"
                          Visibility="{Binding Queued, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Check}" Size="13" Thickness="2.6" Foreground="{DynamicResource Ok}" Margin="0,0,6,0" /><TextBlock Text="Kuyrukta" /></StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhostIcon}" Width="34" Height="34" MinHeight="34"
                            Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Entry.Url}"
                            ToolTip="YouTube'da aç" AutomationProperties.Name="YouTube'da aç">
                      <c:Icon Data="{StaticResource I.Play}" Size="14" />
                    </Button>
                    <Button Style="{StaticResource BtnGhostIcon}" Width="34" Height="34" MinHeight="34"
                            Command="{Binding DataContext.OpenCommand, ElementName=Root}" CommandParameter="{Binding}"
                            ToolTip="Seçeneklerle aç: kalite, biçim, altyazı ve kesme için İndir ekranı" AutomationProperties.Name="Seçeneklerle aç">
                      <c:Icon Data="{StaticResource I.External}" Size="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
