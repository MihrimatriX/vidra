<UserControl x:Class="Vidra.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vidra.App.Controls"
             x:Name="Root">
  <UserControl.Resources>
    <!-- Durum rozeti renkleri -->
    <Style x:Key="StatusPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="{DynamicResource Raised}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text2}" />
      <Setter Property="TextElement.FontSize" Value="12" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Running">
          <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentStrong}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Processing">
          <Setter Property="Background" Value="{DynamicResource InfoSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Info}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="JobBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Processing">
          <Setter Property="Foreground" Value="{DynamicResource Info}" />
          <Setter Property="Background" Value="{DynamicResource InfoSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Paused">
          <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="JobCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Error">
          <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Uzun listeler kendi içinde kayar ve yalnızca görünen öğeleri çizer (sayfa ScrollViewer'ı sanallaştırmayı bozar) -->
    <Style x:Key="VirtualList" TargetType="ItemsControl">
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ItemsPanel">
        <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,14,20,24">
      <!-- Başlık -->
      <DockPanel Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Aynı anda" FontSize="13" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Border BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource BtnIcon}" BorderThickness="0" Background="Transparent" Content="−" Command="{Binding DecConcurrencyCommand}" ToolTip="Azalt" />
              <TextBlock Text="{Binding Concurrency}" Width="24" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
              <Button Style="{StaticResource BtnIcon}" BorderThickness="0" Background="Transparent" Content="+" Command="{Binding IncConcurrencyCommand}" ToolTip="Artır" />
            </StackPanel>
          </Border>
          <Button Command="{Binding PauseAllCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Pause}" Size="15" Margin="0,0,8,0" /><TextBlock Text="Tümünü duraklat" /></StackPanel>
          </Button>
          <Button Command="{Binding ResumeAllCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Play}" Size="15" Margin="0,0,8,0" /><TextBlock Text="Tümünü sürdür" /></StackPanel>
          </Button>
          <ToggleButton Style="{StaticResource Pill}" Margin="0" IsChecked="{Binding SleepWhenDone}" Content="Bitince uyut" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="Kuyruk" />
      </DockPanel>

      <!-- Özet -->
      <WrapPanel Margin="0,0,0,6">
        <WrapPanel.Resources>
          <Style TargetType="Border" BasedOn="{StaticResource Tile}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="TextElement.FontSize" Value="12.5" />
          </Style>
        </WrapPanel.Resources>
        <Border><TextBlock><Run Text="{Binding RunningCount, Mode=OneWay}" FontWeight="SemiBold" /> indiriliyor</TextBlock></Border>
        <Border><TextBlock><Run Text="{Binding QueuedCount, Mode=OneWay}" FontWeight="SemiBold" /> sırada</TextBlock></Border>
        <Border><TextBlock><Run Text="{Binding PausedCount, Mode=OneWay}" FontWeight="SemiBold" /> duraklatıldı</TextBlock></Border>
        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" TextElement.Foreground="{DynamicResource Warn}"
                Visibility="{Binding ErrorCount, Converter={StaticResource Vis}}">
          <TextBlock><Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold" /> dikkat gerekiyor</TextBlock>
        </Border>
        <Border Visibility="{Binding RunningCount, Converter={StaticResource Vis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Queue.TotalSpeed, Converter={StaticResource Bytes}, ConverterParameter=speed}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Viewbox Stretch="Fill" Width="60" Height="14" Margin="8,0,0,0">
              <Canvas Width="120" Height="22">
                <Polyline Points="{Binding Sparkline}" Stroke="{DynamicResource AccentStrong}" StrokeThickness="2" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
          </StackPanel>
        </Border>
      </WrapPanel>

      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- İşler -->
        <StackPanel>
          <Border Style="{StaticResource Tile}" BorderBrush="{DynamicResource Line2}" Visibility="{Binding Queue.Jobs.Count, Converter={StaticResource Vis}, ConverterParameter=!}">
            <TextBlock Style="{StaticResource Body2}" Text="Kuyruk boş. İndir ekranından ya da bir playlist'ten video ekleyebilirsin." />
          </Border>
          <ItemsControl ItemsSource="{Binding Queue.Jobs}" Style="{StaticResource VirtualList}" MaxHeight="480">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource JobCard}">
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectCommand, ElementName=Root}" CommandParameter="{Binding}" />
                  </Border.InputBindings>
                  <StackPanel>
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusPill}" Margin="0,0,10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Stage}" />
                        </Border>
                        <Button ToolTip="Duraklat" Margin="0,0,6,0"
                                Command="{Binding DataContext.PauseCommand, ElementName=Root}" CommandParameter="{Binding}">
                          <c:Icon Data="{StaticResource I.Pause}" Size="15" />
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Queued"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button ToolTip="Devam et" Margin="0,0,6,0" Command="{Binding DataContext.ResumeCommand, ElementName=Root}" CommandParameter="{Binding}">
                          <c:Icon Data="{StaticResource I.Play}" Size="15" />
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" ToolTip="İptal et" Command="{Binding DataContext.CancelCommand, ElementName=Root}" CommandParameter="{Binding}">
                          <c:Icon Data="{StaticResource I.X}" Size="15" />
                        </Button>
                      </StackPanel>
                      <Border DockPanel.Dock="Left" Width="72" Height="40" CornerRadius="6" Background="{DynamicResource ThumbBg}" Margin="0,0,12,0">
                        <Border.Clip><RectangleGeometry Rect="0,0,72,40" RadiusX="6" RadiusY="6" /></Border.Clip>
                        <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=192}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Options, Converter={StaticResource Desc}}" Style="{StaticResource Mono}" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>

                    <!-- İlerleme -->
                    <StackPanel Margin="0,8,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <ProgressBar Style="{StaticResource JobBar}" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                      <WrapPanel Margin="0,4,0,0" TextElement.FontFamily="{StaticResource MonoFont}" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Text2}">
                        <TextBlock Text="{Binding Percent, StringFormat={}%{0:0}}" Margin="0,0,16,0" />
                        <TextBlock Margin="0,0,16,0"><Run Text="{Binding Downloaded, Mode=OneWay, Converter={StaticResource Bytes}}" /> / <Run Text="{Binding Total, Mode=OneWay, Converter={StaticResource Bytes}}" /></TextBlock>
                        <TextBlock Text="{Binding Speed, Converter={StaticResource Bytes}, ConverterParameter=speed}" Margin="0,0,16,0" />
                        <TextBlock Visibility="{Binding Eta, Converter={StaticResource Vis}}"><Run Text="kalan" /> <Run Text="{Binding Eta, Mode=OneWay, Converter={StaticResource Dur}}" /></TextBlock>
                      </WrapPanel>
                    </StackPanel>

                    <!-- Hata -->
                    <Border Style="{StaticResource Notice}" Margin="0,8,0,0" Padding="10,8" Visibility="{Binding ErrorMessage, Converter={StaticResource Vis}}">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Style="{StaticResource BtnSm}" Content="Hesabım" Margin="0,0,8,0" Command="{Binding DataContext.OpenAccountCommand, ElementName=Root}">
                            <Button.Visibility>
                              <Binding Path="ErrorKind" Converter="{StaticResource EqVis}" ConverterParameter="Auth" />
                            </Button.Visibility>
                          </Button>
                          <Button Style="{StaticResource BtnSm}" Content="Tekrar dene" Command="{Binding DataContext.RetryCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0" />
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Ayrıntı -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top" DataContext="{Binding Selected}"
                Visibility="{Binding Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Style="{StaticResource Eyebrow}" Text="Ayrıntı" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextWrapping="Wrap" Margin="0,4,0,14" />
            <Grid Margin="0,0,0,14" TextElement.FontSize="13">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Durum" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
              <TextBlock Grid.Column="1" Text="{Binding Stage}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Text="Format" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Options, Converter={StaticResource Desc}}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Text="Kaynak" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Source, TargetNullValue=Tek video}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Text="Eklendi" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedAt, Converter={StaticResource Rel}}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="4" Text="Dosya" Foreground="{DynamicResource Muted}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FilePath, TargetNullValue=—}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
            </Grid>
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="Kopyala"
                      Command="{Binding DataContext.CopyLogCommand, ElementName=Root}" CommandParameter="{Binding}" />
              <TextBlock Style="{StaticResource Eyebrow}" Text="yt-dlp günlüğü" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox Text="{Binding Log.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                     Height="240" VerticalContentAlignment="Top" Padding="8" Background="{DynamicResource Surface2}" Foreground="{DynamicResource Text2}"
                     VerticalScrollBarVisibility="Auto" TextChanged="Log_TextChanged" />
            <WrapPanel Margin="0,12,0,0">
              <Button Style="{StaticResource BtnSm}" Content="Komutu kopyala" Margin="0,0,8,0"
                      Command="{Binding DataContext.CopyCommandCommand, ElementName=Root}" CommandParameter="{Binding}" />
              <Button Style="{StaticResource BtnSm}" Content="Sıranın başına al"
                      Command="{Binding DataContext.MoveToFrontCommand, ElementName=Root}" CommandParameter="{Binding}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Geçmiş -->
      <DockPanel Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton Style="{StaticResource PillSolid}" Margin="0,0,8,0" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=all, Mode=OneWay}"
                        Click="Filter_Click" Tag="all">
            <TextBlock><Run Text="Hepsi ·" /> <Run Text="{Binding HAll, Mode=OneWay}" /></TextBlock>
          </ToggleButton>
          <ToggleButton Style="{StaticResource PillSolid}" Margin="0,0,8,0" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=video, Mode=OneWay}"
                        Click="Filter_Click" Tag="video">
            <TextBlock><Run Text="Video ·" /> <Run Text="{Binding HVideo, Mode=OneWay}" /></TextBlock>
          </ToggleButton>
          <ToggleButton Style="{StaticResource PillSolid}" Margin="0,0,8,0" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=audio, Mode=OneWay}"
                        Click="Filter_Click" Tag="audio">
            <TextBlock><Run Text="Ses ·" /> <Run Text="{Binding HAudio, Mode=OneWay}" /></TextBlock>
          </ToggleButton>
          <ToggleButton Style="{StaticResource PillSolid}" Margin="0,0,12,0" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=warn, Mode=OneWay}"
                        Click="Filter_Click" Tag="warn">
            <TextBlock><Run Text="Uyarılı ·" /> <Run Text="{Binding HWarn, Mode=OneWay}" /></TextBlock>
          </ToggleButton>
          <TextBox Width="200" Text="{Binding HistoryQuery, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="Başlık veya kanal" Margin="0,0,8,0" />
          <Button Style="{StaticResource BtnSm}" Content="Temizle" Command="{Binding ClearHistoryCommand}" />
        </StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="Geçmiş" VerticalAlignment="Center" FontSize="19" />
      </DockPanel>

      <Border Style="{StaticResource Card}" CornerRadius="16">
        <StackPanel>
          <Border Background="{DynamicResource Surface2}" CornerRadius="16,16,0,0" Padding="12,6">
            <Grid TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Muted}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="80" />
                <ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="230" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Başlık" /><TextBlock Grid.Column="1" Text="Kanal" /><TextBlock Grid.Column="2" Text="Format" /><TextBlock Grid.Column="3" Text="Boyut" />
              <TextBlock Grid.Column="4" Text="Süre" /><TextBlock Grid.Column="5" Text="Tarih" /><TextBlock Grid.Column="6" Text="İşlem" TextAlignment="Right" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding HistoryView}" Style="{StaticResource VirtualList}" MaxHeight="520">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Raised}" BorderThickness="0,1,0,0" Padding="12,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="80" />
                      <ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <Border Style="{StaticResource ChipWarn}" HorizontalAlignment="Left" Margin="0,4,0,0" ToolTip="{Binding Warning}"
                              Visibility="{Binding Warning, Converter={StaticResource Vis}}"><TextBlock Text="uyarı" /></Border>
                      <Border Style="{StaticResource ChipWarn}" HorizontalAlignment="Left" Margin="0,4,0,0"
                              Visibility="{Binding Status, Converter={StaticResource EqVis}, ConverterParameter=Canceled}"><TextBlock Text="iptal edildi" /></Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Channel, TargetNullValue=—}" Foreground="{DynamicResource Text2}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource CellMono}" Text="{Binding Options, Converter={StaticResource Desc}}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource CellMono}" Foreground="{DynamicResource Text}" Text="{Binding Size, Converter={StaticResource Bytes}}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource CellMono}" Text="{Binding Duration, Converter={StaticResource Dur}}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource Cell}" FontSize="12" Foreground="{DynamicResource Text2}" Text="{Binding FinishedAt, Converter={StaticResource Rel}}" />
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Style="{StaticResource BtnSm}" Content="Oynat" Margin="0,0,6,0" Command="{Binding DataContext.OpenCommand, ElementName=Root}" CommandParameter="{Binding}"
                              Visibility="{Binding FilePath, Converter={StaticResource Vis}}" />
                      <Button Style="{StaticResource BtnSm}" Content="Klasör" Margin="0,0,6,0" Command="{Binding DataContext.RevealCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Style="{StaticResource BtnSm}" Content="Tekrar" Margin="0,0,6,0" Command="{Binding DataContext.RedownloadCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="Aynı ayarlarla tekrar indir" />
                      <Button Style="{StaticResource BtnIcon}" Width="34" Height="34" MinHeight="34" ToolTip="Geçmişten kaldır"
                              Command="{Binding DataContext.RemoveHistoryCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <c:Icon Data="{StaticResource I.Trash}" Size="14" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Body2}" Margin="16" Text="Kayıt yok." Visibility="{Binding HAll, Converter={StaticResource Vis}, ConverterParameter=!}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
