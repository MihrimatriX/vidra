<UserControl x:Class="Vidra.App.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Vidra.App.Controls"
             x:Name="Root">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PagePad}" MaxWidth="1120" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource H1}" Text="Hesabım" Margin="0,0,0,6" />
      <TextBlock Style="{StaticResource Body2}" Margin="0,0,0,20" MaxWidth="760" HorizontalAlignment="Left"
                 Text="YouTube hesabını bağlayınca üyelere özel, yaş sınırlı ve sana özel videolar indirilebilir; abonelik akışın ve kayıtlı listelerin burada açılır." />

      <Border Style="{StaticResource Notice}" Margin="0,0,0,16" Visibility="{Binding Notice, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="14" />
      </Border>

      <!-- ===== Oturum kartı ===== -->
      <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,20">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource BtnPrimary}" Command="{Binding SignInCommand}" Margin="0,0,8,0"
                      Visibility="{Binding SignedIn, Converter={StaticResource Vis}, ConverterParameter=!}">
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.LogIn}" Size="16" Margin="0,0,8,0" /><TextBlock Text="YouTube'a giriş yap" /></StackPanel>
              </Button>
              <Button Command="{Binding TestSessionCommand}" Margin="0,0,8,0" Visibility="{Binding SignedIn, Converter={StaticResource Vis}}"
                      IsEnabled="{Binding Busy, Converter={StaticResource Not}}" Content="Oturumu test et" />
              <Button Command="{Binding SignInCommand}" Margin="0,0,8,0" Visibility="{Binding UsesAppLogin, Converter={StaticResource Vis}}" Content="Yenile" />
              <Button Command="{Binding SignOutCommand}" Visibility="{Binding SignedIn, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.LogOut}" Size="16" Margin="0,0,8,0" /><TextBlock Text="Çıkış yap" /></StackPanel>
              </Button>
            </StackPanel>
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" Margin="0,0,16,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource Raised}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SignedIn}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <c:Icon Data="{StaticResource I.User}" Size="22" Foreground="{DynamicResource AccentStrong}" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="{Binding StateTitle}" Style="{StaticResource H2}" />
              <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Body2}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>

          <Border Margin="0,16,0,0" CornerRadius="12" Padding="14,12" Visibility="{Binding TestMessage, Converter={StaticResource Vis}}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TestOk}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OkSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding TestMessage}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          </Border>

          <!-- Nasıl çalışır -->
          <Grid Margin="0,18,0,0" Visibility="{Binding SignedIn, Converter={StaticResource Vis}, ConverterParameter=!}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Tile}" Background="{DynamicResource Surface2}">
              <StackPanel><TextBlock Text="1 · Google'ın kendi sayfası" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Giriş, Vidra içinde açılan Google sayfasında yapılır; şifren uygulamaya hiç iletilmez." /></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Tile}" Background="{DynamicResource Surface2}">
              <StackPanel><TextBlock Text="2 · Ayrı, yerel oturum" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Oturum tarayıcından bağımsızdır ve yalnızca bu bilgisayarda, kendi klasöründe saklanır." /></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Tile}" Background="{DynamicResource Surface2}">
              <StackPanel><TextBlock Text="3 · Tek tıkla çıkış" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Çıkış yapınca çerez dosyası ve giriş penceresinin verileri silinir." /></StackPanel>
            </Border>
          </Grid>

          <CheckBox Style="{StaticResource SwitchCard}" Margin="0,18,0,0" HorizontalAlignment="Left" MinWidth="460" IsChecked="{Binding PoliteMode}"
                    Content="Nazik mod (önerilir)" Tag="Oturum açıkken istekler arasına kısa bekleme ekler; hesabın ya da IP'nin işaretlenme riskini azaltır" />
        </StackPanel>
      </Border>

      <!-- ===== Tarayıcı eklentisi: oturumun tek sahibi gerçek tarayıcı olur, dışa aktarılmış kopya bayatlamaz ===== -->
      <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,20">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Command="{Binding InstallExtensionCommand}" Margin="0,0,8,0" Content="Eklentiyi kur" />
              <Button Style="{StaticResource BtnPrimary}" Command="{Binding UseExtensionCommand}" Content="Eklenti oturumunu kullan"
                      Visibility="{Binding UsesExtension, Converter={StaticResource Vis}, ConverterParameter=!}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tarayıcı eklentisi" Style="{StaticResource H3}" />
                <Border Style="{StaticResource ChipOk}" Margin="10,0,0,0" Visibility="{Binding UsesExtension, Converter={StaticResource Vis}}"><TextBlock Text="Kullanılıyor" /></Border>
              </StackPanel>
              <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="Chrome, Edge ya da Brave'deki YouTube oturumunu Vidra ile sürekli eşitler: YouTube çerezleri yeniledikçe Vidra da yenisini alır, hesaptan atılma biter. YouTube'da sağ tık › &quot;Vidra ile indir&quot; de ekler." />
              <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" Text="{Binding ExtensionState}" />
            </StackPanel>
          </DockPanel>
          <Border Margin="0,14,0,0" Style="{StaticResource Tile}" Background="{DynamicResource Surface2}" Visibility="{Binding ExtensionHelp, Converter={StaticResource Vis}}">
            <StackPanel>
              <TextBlock Text="Kurulum (bir kez)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="1 · Tarayıcının adres çubuğuna chrome://extensions yaz (Edge: edge://extensions, Brave: brave://extensions)." />
              <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="2 · &quot;Geliştirici modu&quot;nu aç." />
              <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="3 · &quot;Paketlenmemiş öğe yükle&quot;ye bas ve az önce açılan klasörü seç." />
              <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="4 · Tarayıcıda YouTube'a giriş yapılıysa eklenti birkaç saniye içinde oturumu Vidra'ya gönderir." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ===== Hesaplar: uygulama içi girişle eklenenler, tek tıkla geçiş ===== -->
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Command="{Binding AddAccountCommand}">
          <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource I.Plus}" Size="15" Margin="0,0,8,0" /><TextBlock Text="Hesap ekle" /></StackPanel>
        </Button>
        <TextBlock Style="{StaticResource H2}" Text="Hesaplar" VerticalAlignment="Center" />
      </DockPanel>
      <Border Style="{StaticResource Card}" CornerRadius="16" Margin="0,0,0,24">
        <StackPanel>
          <TextBlock Style="{StaticResource Body2}" Margin="18" Visibility="{Binding Accounts.Count, Converter={StaticResource Vis}, ConverterParameter=!}"
                     Text="Uygulama içi girişle eklenen hesaplar burada listelenir; aralarında tek tıkla geçebilirsin." />
          <ItemsControl ItemsSource="{Binding Accounts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Raised}" BorderThickness="0,0,0,1" Padding="18,10">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Style="{StaticResource ChipOk}" Margin="0,0,8,0" Visibility="{Binding Active, Converter={StaticResource Vis}}"><TextBlock Text="Etkin" /></Border>
                      <Button Style="{StaticResource BtnSm}" Content="Kullan" Margin="0,0,6,0" Visibility="{Binding Active, Converter={StaticResource Vis}, ConverterParameter=!}"
                              Command="{Binding DataContext.UseAccountCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Style="{StaticResource BtnSm}" Content="Kaldır" ToolTip="Hesabın oturum dosyalarını bu bilgisayardan siler"
                              Command="{Binding DataContext.RemoveAccountCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                      <TextBox Text="{Binding Name}" Width="220" HorizontalAlignment="Left" FontWeight="SemiBold" AutomationProperties.Name="Hesap adı" ToolTip="Adı değiştirmek için yaz" />
                      <TextBlock Style="{StaticResource Small}" Text="{Binding Detail}" Margin="0,4,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===== Hesap akışları ===== -->
      <TextBlock Style="{StaticResource H2}" Text="Hesap akışları" Margin="0,0,0,10" />
      <ItemsControl ItemsSource="{Binding Feeds}" Margin="0,0,0,12">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:UniformWrapPanel MinItemWidth="220" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0,0,12,12" Padding="16,14" HorizontalContentAlignment="Stretch" Tag="14"
                    Command="{Binding DataContext.OpenFeedCommand, ElementName=Root}" CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.SignedIn, ElementName=Root}">
              <DockPanel>
                <c:Icon DockPanel.Dock="Right" Data="{StaticResource I.External}" Size="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock Text="{Binding Label}" FontSize="16" />
                  <TextBlock Text="{Binding Hint}" Style="{StaticResource Small}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource Small}" Margin="0,0,0,24" Visibility="{Binding SignedIn, Converter={StaticResource Vis}, ConverterParameter=!}"
                 Text="Akışları açmak için giriş yapmalısın." />

      <!-- ===== Takip edilenler ===== -->
      <DockPanel Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Kontrol aralığı" FontSize="14" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Width="160" ItemsSource="{Binding FollowIntervals}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FollowInterval}" />
        </StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="Takip edilen listeler" VerticalAlignment="Center" />
      </DockPanel>
      <Border Style="{StaticResource Card}" CornerRadius="16">
        <StackPanel>
          <TextBlock Style="{StaticResource Body2}" Margin="18" Visibility="{Binding Follows.Count, Converter={StaticResource Vis}, ConverterParameter=!}"
                     Text="Henüz takip edilen liste yok. Bir playlist ya da kanal açıp &quot;Takip et&quot;e bastığında yeni videolar otomatik olarak kuyruğa eklenir." />
          <ItemsControl ItemsSource="{Binding Follows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Raised}" BorderThickness="0,0,0,1" Padding="18,12">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Style="{StaticResource BtnSm}" Content="Aç" Margin="0,0,6,0" Command="{Binding DataContext.OpenFollowedCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Style="{StaticResource BtnSm}" Content="Şimdi kontrol et" Margin="0,0,6,0" Command="{Binding DataContext.CheckNowCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Style="{StaticResource BtnSm}" Content="Bırak" Command="{Binding DataContext.UnfollowCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource Small}">
                        <Run Text="{Binding Options, Mode=OneWay, Converter={StaticResource Desc}}" /> <Run Text="· son kontrol" />
                        <Run Text="{Binding LastChecked, Mode=OneWay, Converter={StaticResource Rel}}" /> <Run Text="·" />
                        <Run Text="{Binding LastNewCount, Mode=OneWay}" /> <Run Text="yeni" />
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
