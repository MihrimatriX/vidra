<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Vidra.App.Controls">

  <!-- İkonlar bu sözlükteki şablonlarda StaticResource ile kullanılıyor: kardeş sözlüğe güvenmek yerine burada birleştir -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <CornerRadius x:Key="RSm">10</CornerRadius>
  <CornerRadius x:Key="RMd">14</CornerRadius>
  <CornerRadius x:Key="RLg">18</CornerRadius>

  <!-- ============ Metin ============ -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style x:Key="H3" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
  </Style>
  <Style x:Key="Body2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Small" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>

  <!-- ============ Kart ============ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RLg}" />
  </Style>
  <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="CornerRadius" Value="{StaticResource RMd}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style x:Key="Notice" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RMd}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}" />
  </Style>
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style x:Key="ChipGold" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource Gold}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GoldInk}" />
  </Style>
  <Style x:Key="ChipOk" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource OkSoft}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ok}" />
  </Style>
  <Style x:Key="ChipWarn" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}" />
  </Style>

  <!-- ============ Butonlar ============ -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="12" RadiusY="12" Stroke="{DynamicResource AccentStrong}" StrokeThickness="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Tag" Value="{StaticResource RSm}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Raised}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Btn}" />

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BtnDark" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Invert}" />
    <Setter Property="Foreground" Value="{DynamicResource InvertInk}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="BtnLg" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Tag" Value="12" />
  </Style>
  <Style x:Key="BtnPrimaryLg" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Tag" Value="12" />
  </Style>
  <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Tag" Value="8" />
  </Style>
  <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="BtnGhostIcon" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <!-- Özel başlık çubuğu düğmeleri (WindowChrome içinde tıklanabilir olmaları için IsHitTestVisibleInChrome) -->
  <Style x:Key="CaptionBtn" TargetType="Button">
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Raised}" />
              <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BtnLink" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <!-- Kenar menü öğesi -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" MinHeight="34" Padding="10,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
              <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Hap (pill): altyazı dili, SponsorBlock kategorisi, filtre -->
  <Style x:Key="Pill" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" MinHeight="30" Padding="11,0" CornerRadius="15" BorderThickness="1.5"
                  BorderBrush="{DynamicResource Line2}" Background="{DynamicResource Surface}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <c:Icon x:Name="Tick" Data="{StaticResource I.Check}" Size="14" Thickness="3" Margin="0,0,6,0"
                      Foreground="{DynamicResource AccentStrong}" Visibility="Collapsed" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Koyu dolgulu filtre hapı (Hepsi / İndirilmemiş / Üye) -->
  <Style x:Key="PillSolid" TargetType="ToggleButton" BasedOn="{StaticResource Pill}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" MinHeight="30" Padding="11,0" CornerRadius="15" BorderThickness="1.5"
                  BorderBrush="{DynamicResource Line2}" Background="{DynamicResource Surface}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Anahtar (CheckBox → switch kartı). Content = başlık, Tag = açıklama ============ -->
  <Style x:Key="SwitchCard" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Bd" MinHeight="46" Padding="12,6" CornerRadius="12" BorderThickness="1"
                  BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface2}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <ContentPresenter TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
              <Border x:Name="Track" Grid.Column="1" Width="40" Height="24" CornerRadius="12" Background="{DynamicResource Line2}" VerticalAlignment="Center">
                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentStrong}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line2}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Satır onay kutusu (playlist listesi) -->
  <Style x:Key="CheckBox" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#9AA3AF"
                    Background="{DynamicResource Surface}" VerticalAlignment="Center">
              <c:Icon x:Name="Tick" Data="{StaticResource I.Check}" Size="13" Thickness="3" Foreground="{DynamicResource AccentInk}" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox}" />

  <!-- ============ Seçim listeleri ============ -->
  <!-- Kart ızgarası: kalite/ses formatı/çerez kaynağı. ItemTemplate kart içeriğini verir -->
  <Style x:Key="OptionItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" MinHeight="54" Padding="12,8" CornerRadius="12" BorderThickness="1.5"
                  BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OptionList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource OptionItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <c:UniformWrapPanel MinItemWidth="150" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bölümlü kontrol: ListBox + Choice öğeleri (DisplayMemberPath=Label, SelectedValuePath=Value) -->
  <Style x:Key="SegmentItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" MinHeight="30" Padding="12,0" CornerRadius="8" Background="Transparent" Margin="1.5">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.12" Color="#14171C" />
                </Setter.Value>
              </Setter>
              <Setter Property="Foreground" Value="{DynamicResource Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="DisplayMemberPath" Value="Label" />
    <Setter Property="SelectedValuePath" Value="Value" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="1.5">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Alt çizgili sekmeler -->
  <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" MinHeight="40" Padding="14,0" BorderThickness="0,0,0,2.5" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
              <Setter Property="Foreground" Value="{DynamicResource Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Tabs" TargetType="ListBox" BasedOn="{StaticResource Segmented}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource TabItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Giriş alanları ============ -->
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <Grid>
              <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}" Margin="12,0"
                         VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" FontFamily="{TemplateBinding FontFamily}" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Input}" />
  <Style x:Key="InputMono" TargetType="TextBox" BasedOn="{StaticResource Input}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Etiketli alan: Header üstte, içerik altta -->
  <Style x:Key="Field" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <StackPanel>
            <ContentPresenter ContentSource="Header" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Text2}" Margin="0,0,0,6" />
            <ContentPresenter />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox: varsayılan Aero şablonu renkleri yok sayar, bu yüzden sade bir şablon -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <c:Icon Data="M6,9 L12,15 L18,9" Size="14" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource Muted}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Padding="10,8" CornerRadius="7" Background="Transparent" Margin="4,1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Raised}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,8"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="0,4">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#14171C" />
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Muted}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ İlerleme çubuğu ============ -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
            <!-- Belirsiz durum: nabız gibi atan tam genişlik çubuk -->
            <Border x:Name="Pulse" Background="{TemplateBinding Foreground}" CornerRadius="3" Opacity="0" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="PulseAnim">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.7" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="PulseAnim" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ İnce kaydırma çubuğu ============ -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="4" Background="{DynamicResource Line2}" Margin="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Invert}" />
    <Setter Property="Foreground" Value="{DynamicResource InvertInk}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Tablolar için hücre metni -->
  <Style x:Key="Cell" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
</ResourceDictionary>
